# Set the default behavior to enforce LF line endings for all text files.
* text=auto eol=lf

# Explicitly set eol for typical text formats
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Preserve the upstream model license byte-for-byte for its SHA-256 pin.
experiments/licenses/Qwen3.8-27B-1d4bf0f-LICENSE -text -eol whitespace=cr-at-eol
